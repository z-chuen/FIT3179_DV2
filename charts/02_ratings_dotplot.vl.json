{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Top 10 household listings by source rating count in a 349-listing Shopee Malaysia sample. Labels are shortened for display; full listing titles remain in tooltips. Rating counts are rounded source values and are not sales.",
  "width": 760,
  "height": {
    "step": 48
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": false
  },
  "padding": {
    "top": 16,
    "left": 8,
    "right": 18,
    "bottom": 12
  },
  "title": {
    "text": "Most-rated household listings",
    "subtitle": [
      "Top 10 of 349 Shopee Malaysia listings",
      "24 Apr–13 May 2023 | Source counts are rounded"
    ],
    "anchor": "start",
    "frame": "bounds"
  },
  "data": {
    "url": "data/shopee_household_2023.csv",
    "format": {
      "type": "csv",
      "parse": {
        "rating_count": "number",
        "item_rating": "number",
        "price_actual": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.rating_count) && datum.rating_count > 0"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "listing_rank"
        }
      ],
      "sort": [
        {
          "field": "rating_count",
          "order": "descending"
        },
        {
          "field": "product_id",
          "order": "ascending"
        }
      ]
    },
    {
      "filter": "datum.listing_rank <= 10"
    },
    {
      "lookup": "product_id",
      "from": {
        "data": {
          "values": [
            {
              "product_id": "1530870.952452923",
              "short_label": "PRODIY scale|Kitchen, 10 kg"
            },
            {
              "product_id": "370480745.9212054157",
              "short_label": "DESSINI cookware|12 pieces"
            },
            {
              "product_id": "46241709.4545868397",
              "short_label": "3-tier clothes|drying rack"
            },
            {
              "product_id": "332348591.9577001453",
              "short_label": "Clothes hanging|rack"
            },
            {
              "product_id": "182480224.3901784341",
              "short_label": "Stainless steel|dish rack"
            },
            {
              "product_id": "68461810.1256477380",
              "short_label": "Vinda tissue|16 rolls"
            },
            {
              "product_id": "55633367.6843567214",
              "short_label": "Laundry gel beads|1 piece"
            },
            {
              "product_id": "18765557.7640461934",
              "short_label": "Cake / food boxes|1 piece"
            },
            {
              "product_id": "118059163.3344049714",
              "short_label": "Silicone utensils|12 pieces"
            },
            {
              "product_id": "68461810.9188496668",
              "short_label": "Vinda tissue|27 rolls"
            }
          ]
        },
        "key": "product_id",
        "fields": [
          "short_label"
        ]
      }
    },
    {
      "calculate": "isValid(datum.short_label) ? datum.short_label : datum.title",
      "as": "listing_label"
    }
  ],
  "encoding": {
    "y": {
      "field": "listing_label",
      "type": "nominal",
      "sort": {
        "field": "listing_rank",
        "op": "min",
        "order": "ascending"
      },
      "title": null,
      "axis": {
        "labelExpr": "split(datum.label, '|')",
        "labelLimit": 170,
        "labelLineHeight": 17,
        "labelPadding": 12,
        "labelFontWeight": "bold",
        "ticks": false,
        "domain": false
      }
    },
    "color": {
      "field": "topic_group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Cleaning supplies",
          "Storage products",
          "Kitchen essentials"
        ],
        "range": [
          "#17857c",
          "#8266b2",
          "#ce7b22"
        ]
      },
      "legend": {
        "title": "Product category",
        "orient": "bottom",
        "direction": "vertical",
        "columns": 1,
        "labelLimit": 250,
        "symbolOpacity": 1
      }
    },
    "tooltip": [
      {
        "field": "listing_rank",
        "type": "quantitative",
        "title": "Rank in sample",
        "format": "d"
      },
      {
        "field": "title",
        "type": "nominal",
        "title": "Full listing name"
      },
      {
        "field": "topic_group",
        "type": "nominal",
        "title": "Product category"
      },
      {
        "field": "total_rating",
        "type": "nominal",
        "title": "Number of ratings (source)"
      },
      {
        "field": "item_rating",
        "type": "quantitative",
        "title": "Overall rating out of 5",
        "format": ".1f"
      },
      {
        "field": "price_actual",
        "type": "quantitative",
        "title": "Listed price (RM)",
        "format": ".2f"
      },
      {
        "field": "w_date",
        "type": "nominal",
        "title": "Observed on"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "opacity": 0.55
      },
      "encoding": {
        "x": {
          "field": "rating_count",
          "type": "quantitative",
          "title": [
            "Number of ratings",
            "(approximate)"
          ],
          "scale": {
            "domain": [
              0,
              60000
            ],
            "zero": true
          },
          "axis": {
            "values": [
              0,
              20000,
              40000,
              60000
            ],
            "format": "~s",
            "grid": true,
            "labelExpr": "datum.value === 0 ? '0' : format(datum.value, '~s')"
          }
        },
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 150,
        "opacity": 1,
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "rating_count",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -11,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#172b46"
      },
      "encoding": {
        "x": {
          "field": "rating_count",
          "type": "quantitative"
        },
        "text": {
          "field": "total_rating",
          "type": "nominal"
        },
        "color": {
          "value": "#172b46"
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "background": "white",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#465467",
      "titleColor": "#172b46",
      "gridColor": "#e6ecf0",
      "domainColor": "#bdc8d2",
      "tickColor": "#bdc8d2",
      "titlePadding": 14
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#465467",
      "titleColor": "#172b46",
      "symbolType": "circle",
      "symbolSize": 100
    },
    "title": {
      "fontSize": 20,
      "color": "#172b46",
      "subtitleFontSize": 12,
      "subtitleColor": "#536174",
      "offset": 18
    }
  }
}
