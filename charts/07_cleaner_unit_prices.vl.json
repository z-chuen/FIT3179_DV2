{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Median observed RM/L for Ajax Fabuloso lavender 2 L, Mr Muscle lavender 2 L and Dettol lavender 2.5 L. Each outlet contributes one median before the national sample median. Different formulations can have different performance; this chart compares price per litre only.",
  "width": 900,
  "height": 440,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": false
  },
  "padding": {
    "top": 36,
    "left": 8,
    "right": 12,
    "bottom": 10
  },
  "title": {
    "text": [
      "Multipurpose-cleaner prices",
      "per litre"
    ],
    "subtitle": [
      "PriceCatcher · observations on 12 Oct 2026",
      "Lavender cleaners; prices standardised to volume."
    ],
    "anchor": "start",
    "frame": "bounds"
  },
  "config": {
    "font": "Arial",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 14,
      "titleFontSize": 14,
      "labelColor": "#172b46",
      "titleColor": "#172b46",
      "gridColor": "#d9e2eb",
      "domainColor": "#bdc8d2",
      "tickColor": "#bdc8d2",
      "titlePadding": 15,
      "domain": false,
      "ticks": false
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#465467",
      "titleColor": "#172b46",
      "symbolStrokeWidth": 0
    },
    "title": {
      "fontSize": 22,
      "color": "#172b46",
      "subtitleFontSize": 12,
      "subtitleColor": "#425466",
      "anchor": "start",
      "offset": 20
    }
  },
  "data": {
    "url": "https://raw.githubusercontent.com/z-chuen/FIT3179_DV2/main/data/pricecatcher_household_oct2026.csv",
    "format": {
      "type": "csv",
      "parse": {
        "premise_code": "number",
        "item_code": "number",
        "price": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "indexof([1998,1999,2000],datum.item_code)>=0"
    },
    {
      "lookup": "item_code",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/z-chuen/FIT3179_DV2/main/data/lookup_item.csv",
          "format": {
            "type": "csv",
            "parse": {
              "item_code": "number"
            }
          }
        },
        "key": "item_code",
        "fields": [
          "item",
          "unit"
        ]
      }
    },
    {
      "calculate": "datum.item_code === 1998 ? 'Dettol lavender · 2.5 L' : datum.item_code === 1999 ? 'Mr Muscle lavender · 2 L' : 'Ajax Fabuloso lavender · 2 L'",
      "as": "product_label"
    },
    {
      "calculate": "datum.item_code===1998 ? 2.5 : 2",
      "as": "pack_litres"
    },
    {
      "aggregate": [
        {
          "op": "median",
          "field": "price",
          "as": "outlet_pack_rm"
        }
      ],
      "groupby": [
        "item_code",
        "premise_code",
        "product_label",
        "pack_litres",
        "item",
        "unit"
      ]
    },
    {
      "calculate": "datum.outlet_pack_rm / datum.pack_litres",
      "as": "outlet_rm_litre"
    },
    {
      "aggregate": [
        {
          "op": "median",
          "field": "outlet_rm_litre",
          "as": "median_rm_litre"
        },
        {
          "op": "count",
          "as": "n_outlets"
        }
      ],
      "groupby": [
        "product_label",
        "item",
        "unit"
      ]
    }
  ],
  "encoding": {
    "y": {
      "field": "product_label",
      "type": "nominal",
      "sort": [
        "Mr Muscle lavender · 2 L",
        "Ajax Fabuloso lavender · 2 L",
        "Dettol lavender · 2.5 L"
      ],
      "title": null,
      "axis": {
        "labelExpr": "split(replace(datum.label, ' lavender', ''), ' · ')",
        "labelFontSize": 14,
        "labelFontWeight": "bold",
        "labelLineHeight": 19,
        "labelLimit": 160,
        "labelPadding": 14,
        "labelOverlap": false,
        "labelColor": "#172b46",
        "ticks": false,
        "domain": false
      },
      "scale": {
        "paddingInner": 0.45,
        "paddingOuter": 0.3
      }
    },
    "x": {
      "field": "median_rm_litre",
      "type": "quantitative",
      "title": [
        "Median observed price",
        "(RM per litre)"
      ],
      "scale": {
        "zero": true,
        "domain": [
          0,
          10
        ],
        "nice": false
      },
      "axis": {
        "format": ".0f",
        "values": [
          0,
          2,
          4,
          6,
          8,
          10
        ],
        "labelPadding": 9,
        "titleLineHeight": 19,
        "titleFontSize": 14,
        "grid": true,
        "gridColor": "#d9e2eb",
        "domain": false,
        "ticks": false
      },
      "stack": null
    },
    "tooltip": [
      {
        "field": "item",
        "title": "Official item name"
      },
      {
        "field": "unit",
        "title": "Official pack unit"
      },
      {
        "field": "median_rm_litre",
        "type": "quantitative",
        "title": "Median RM/L",
        "format": ".2f"
      },
      {
        "field": "n_outlets",
        "type": "quantitative",
        "title": "Sampled outlets"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 5,
        "size": 42
      },
      "encoding": {
        "color": {
          "field": "product_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "Mr Muscle lavender · 2 L",
              "Ajax Fabuloso lavender · 2 L",
              "Dettol lavender · 2.5 L"
            ],
            "range": [
              "#1D5A96",
              "#A94F05",
              "#006D62"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -11,
        "fontSize": 16,
        "fontWeight": "bold",
        "color": "#ffffff"
      },
      "encoding": {
        "text": {
          "field": "price_label",
          "type": "nominal"
        }
      },
      "transform": [
        {
          "calculate": "'RM ' + format(datum.median_rm_litre, '.2f')",
          "as": "price_label"
        }
      ]
    }
  ]
}
