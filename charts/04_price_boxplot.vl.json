{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Horizontal price box plot by the five source category groups. Prices are advertised per listing or variation, not standardised per litre, kilogram or piece. Whiskers use 1.5 IQR; dots beyond them are outliers, not errors established by this chart. Price comparisons exclude five source-reviewed gift/redemption/non-sale listings by product_id: 44437739.12410830021, 52784309.18045431232, 52784309.22224842773, 62781995.22828814214, 635979077.21639543747. This is a listing-type rule, not a price cutoff; genuine sale bundles mentioning free gifts remain included. The shared CSV is unchanged. The 343 retained positive prices range from RM0.06 to RM299.",
  "width": 760,
  "height": 360,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": false
  },
  "padding": {
    "top": 12,
    "left": 8,
    "right": 12,
    "bottom": 12
  },
  "title": {
    "text": "Shopee Malaysia | 2023",
    "subtitle": [
      "24 Apr–13 May | n = 343",
      "5 gift listings excluded",
      "Box: middle 50%; line: median"
    ],
    "anchor": "start",
    "fontSize": 12,
    "fontWeight": "normal",
    "subtitleFontSize": 11,
    "subtitlePadding": 4,
    "offset": 14
  },
  "config": {
    "font": "Arial",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#465467",
      "titleColor": "#172b46",
      "gridColor": "#e6ecf0",
      "domainColor": "#bdc8d2",
      "tickColor": "#bdc8d2",
      "titlePadding": 12,
      "labelPadding": 5
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#465467",
      "titleColor": "#172b46",
      "symbolStrokeWidth": 0
    },
    "title": {
      "fontSize": 12,
      "color": "#172b46",
      "subtitleFontSize": 11,
      "subtitleColor": "#536174",
      "anchor": "start",
      "offset": 16
    }
  },
  "data": {
    "url": "data/shopee_household_2023.csv",
    "format": {
      "type": "csv",
      "parse": {
        "price_actual": "number",
        "price_ori": "number",
        "item_rating": "number",
        "rating_count": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.price_actual) && datum.price_actual > 0"
    },
    {
      "filter": "indexof([\"44437739.12410830021\",\"52784309.18045431232\",\"52784309.22224842773\",\"62781995.22828814214\",\"635979077.21639543747\"], datum.product_id) < 0"
    }
  ],
  "mark": {
    "type": "boxplot",
    "extent": 1.5,
    "size": 22,
    "median": {
      "color": "#172b46",
      "strokeWidth": 2
    },
    "outliers": {
      "filled": true,
      "size": 22,
      "opacity": 0.7
    }
  },
  "encoding": {
    "x": {
      "field": "price_actual",
      "type": "quantitative",
      "title": "Price (RM, log)",
      "scale": {
        "type": "log",
        "domain": [
          0.05,
          400
        ],
        "nice": false
      },
      "axis": {
        "values": [
          0.1,
          1,
          10,
          100,
          300
        ],
        "labelExpr": "'RM' + format(datum.value, '~g')",
        "labelOverlap": "greedy",
        "labelSeparation": 8,
        "labelFlush": 20,
        "labelFontSize": 11,
        "titleFontSize": 12,
        "grid": true
      }
    },
    "y": {
      "field": "source_category_group",
      "type": "nominal",
      "title": null,
      "sort": [
        "Housekeeping & Laundry",
        "Household Supplies",
        "Home Storage & Organization",
        "Kitchen Storage",
        "Kitchen & Dining"
      ],
      "axis": {
        "labelExpr": "datum.label === 'Housekeeping & Laundry' ? ['Housekeeping', '& Laundry'] : datum.label === 'Household Supplies' ? ['Household', 'Supplies'] : datum.label === 'Home Storage & Organization' ? ['Home Storage', '& Organization'] : datum.label === 'Kitchen Storage' ? ['Kitchen', 'Storage'] : ['Kitchen', '& Dining']",
        "labelFontSize": 11,
        "labelLineHeight": 14,
        "labelPadding": 8,
        "labelLimit": 130,
        "labelOverlap": false
      }
    },
    "color": {
      "field": "topic_group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Cleaning supplies",
          "Storage products",
          "Kitchen essentials"
        ],
        "range": [
          "#17857c",
          "#8266b2",
          "#ce7b22"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "source_category_group",
        "type": "nominal",
        "title": "Category group"
      }
    ]
  }
}
