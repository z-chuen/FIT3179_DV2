{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "100% stacked bars show the share of sampled household listings in each overall-rating group within five product subcategories. Each listing counts once. These are listing-level ratings, not individual reviews.",
  "width": 900,
  "height": {
    "step": 72
  },
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": false
  },
  "padding": {
    "top": 20,
    "left": 8,
    "right": 16,
    "bottom": 14
  },
  "title": {
    "text": [
      "Rating distribution by",
      "product subcategory"
    ],
    "subtitle": [
      "Shopee Malaysia | 24 Apr–13 May 2023",
      "Each bar totals 100%. n = listings in group."
    ],
    "anchor": "start",
    "frame": "bounds"
  },
  "data": {
    "url": "data/shopee_household_2023.csv",
    "format": {
      "type": "csv",
      "parse": {
        "item_rating": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.item_rating) && datum.item_rating >= 1 && datum.item_rating <= 5"
    },
    {
      "calculate": "datum.item_rating < 4.8 ? 'Below 4.8' : datum.item_rating < 4.9 ? '4.8' : datum.item_rating < 5 ? '4.9' : '5.0'",
      "as": "rating_band"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "n"
        }
      ],
      "groupby": [
        "source_category_group",
        "rating_band"
      ]
    },
    {
      "impute": "n",
      "key": "rating_band",
      "keyvals": [
        "Below 4.8",
        "4.8",
        "4.9",
        "5.0"
      ],
      "groupby": [
        "source_category_group"
      ],
      "value": 0
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "n",
          "as": "category_n"
        }
      ],
      "groupby": [
        "source_category_group"
      ]
    },
    {
      "calculate": "datum.n / datum.category_n",
      "as": "share"
    },
    {
      "calculate": "indexof(['Below 4.8', '4.8', '4.9', '5.0'], datum.rating_band)",
      "as": "band_order"
    },
    {
      "calculate": "indexof(['Housekeeping & Laundry', 'Household Supplies', 'Home Storage & Organization', 'Kitchen Storage', 'Kitchen & Dining'], datum.source_category_group)",
      "as": "category_order"
    },
    {
      "calculate": "(datum.source_category_group === 'Housekeeping & Laundry' ? 'Housekeeping|& laundry' : datum.source_category_group === 'Household Supplies' ? 'Household|supplies' : datum.source_category_group === 'Home Storage & Organization' ? 'Home storage|& organisation' : datum.source_category_group === 'Kitchen Storage' ? 'Kitchen|storage' : 'Kitchen|& dining') + '|n = ' + datum.category_n",
      "as": "category_label"
    },
    {
      "stack": "n",
      "groupby": [
        "source_category_group"
      ],
      "sort": [
        {
          "field": "band_order",
          "order": "ascending"
        }
      ],
      "offset": "normalize",
      "as": [
        "share_start",
        "share_end"
      ]
    },
    {
      "calculate": "(datum.share_start + datum.share_end) / 2",
      "as": "share_mid"
    }
  ],
  "encoding": {
    "y": {
      "field": "category_label",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "category_order",
        "op": "min",
        "order": "ascending"
      },
      "axis": {
        "labelExpr": "split(datum.label, '|')",
        "labelFontSize": 12,
        "labelFontWeight": "bold",
        "labelLineHeight": 16,
        "labelLimit": 160,
        "labelPadding": 12,
        "ticks": false,
        "domain": false
      }
    },
    "tooltip": [
      {
        "field": "source_category_group",
        "type": "nominal",
        "title": "Product subcategory"
      },
      {
        "field": "rating_band",
        "type": "nominal",
        "title": "Overall rating"
      },
      {
        "field": "n",
        "type": "quantitative",
        "title": "Listings in rating group",
        "format": "d"
      },
      {
        "field": "category_n",
        "type": "quantitative",
        "title": "Listings in subcategory",
        "format": "d"
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "Share of subcategory",
        "format": ".1%"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 42,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "share_start",
          "type": "quantitative",
          "title": "Share of listings",
          "scale": {
            "domain": [
              0,
              1
            ],
            "zero": true,
            "nice": false
          },
          "axis": {
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ],
            "format": ".0%",
            "grid": true,
            "labelOverlap": true
          }
        },
        "x2": {
          "field": "share_end"
        },
        "color": {
          "field": "rating_band",
          "type": "ordinal",
          "sort": [
            "Below 4.8",
            "4.8",
            "4.9",
            "5.0"
          ],
          "scale": {
            "domain": [
              "Below 4.8",
              "4.8",
              "4.9",
              "5.0"
            ],
            "range": [
              "#e2e8f0",
              "#9ecae1",
              "#1d6fa5",
              "#083e6b"
            ]
          },
          "legend": {
            "title": "Rating out of 5",
            "titleLimit": 200,
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "labelLimit": 120,
            "columnPadding": 24,
            "symbolType": "square"
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "share_mid",
          "type": "quantitative"
        },
        "text": {
          "type": "nominal",
          "field": "percentage_label"
        },
        "color": {
          "condition": {
            "test": "datum.band_order >= 2",
            "value": "white"
          },
          "value": "#172b46"
        }
      },
      "transform": [
        {
          "calculate": "datum.share * width >= 48 ? format(datum.share, '.1%') : ''",
          "as": "percentage_label"
        }
      ]
    }
  ],
  "config": {
    "font": "Arial",
    "background": "white",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#465467",
      "titleColor": "#172b46",
      "gridColor": "#e6ecf0",
      "domainColor": "#bdc8d2",
      "tickColor": "#bdc8d2",
      "titlePadding": 14
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#465467",
      "titleColor": "#172b46",
      "offset": 18
    },
    "title": {
      "fontSize": 20,
      "color": "#172b46",
      "subtitleFontSize": 12,
      "subtitleColor": "#536174",
      "offset": 18
    }
  }
}
