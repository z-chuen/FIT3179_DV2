{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Slope chart for five food-storage listings selected by highest source rating count among valid advertised reductions with a listed price between RM5 and RM250. Endpoints are fields from the same observation, not dates. A reference price is not verified past transaction evidence. The displayed y axis is logarithmic.",
  "width": 760,
  "height": 560,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "top": 40,
    "left": 8,
    "right": 8,
    "bottom": 8
  },
  "title": {
    "text": [
      "Advertised reference prices",
      "versus listed selling prices"
    ],
    "subtitle": [
      "Shopee Malaysia | 24 Apr–13 May 2023",
      "Five food-storage examples with advertised reductions and listed prices of RM5–RM250."
    ],
    "anchor": "start"
  },
  "config": {
    "font": "Arial",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#465467",
      "titleColor": "#172b46",
      "gridColor": "#e6ecf0",
      "domainColor": "#bdc8d2",
      "tickColor": "#bdc8d2",
      "titlePadding": 10
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#465467",
      "titleColor": "#172b46",
      "symbolStrokeWidth": 0
    },
    "title": {
      "fontSize": 20,
      "color": "#172b46",
      "subtitleFontSize": 12,
      "subtitleColor": "#536174",
      "anchor": "start",
      "offset": 16
    }
  },
  "data": {
    "url": "https://raw.githubusercontent.com/z-chuen/FIT3179_DV2/main/data/shopee_household_2023.csv",
    "format": {
      "type": "csv",
      "parse": {
        "price_actual": "number",
        "price_ori": "number",
        "item_rating": "number",
        "rating_count": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.product_category === 'Food Storage & Dispensers' && isValid(datum.price_ori) && isValid(datum.price_actual) && datum.price_ori > datum.price_actual && datum.price_actual >= 5 && datum.price_actual <= 250"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "example_rank"
        }
      ],
      "sort": [
        {
          "field": "rating_count",
          "order": "descending"
        },
        {
          "field": "product_id",
          "order": "ascending"
        }
      ]
    },
    {
      "filter": "datum.example_rank <= 5"
    },
    {
      "calculate": "length(datum.title)>64 ? substring(datum.title,0,61)+'…' : datum.title",
      "as": "short_title"
    },
    {
      "fold": [
        "price_ori",
        "price_actual"
      ],
      "as": [
        "price_field",
        "price_rm"
      ]
    },
    {
      "calculate": "datum.price_field === 'price_ori' ? 'Advertised reference' : 'Listed selling price'",
      "as": "price_type"
    }
  ],
  "encoding": {
    "x": {
      "field": "price_type",
      "type": "nominal",
      "sort": [
        "Advertised reference",
        "Listed selling price"
      ],
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 13,
        "labelLimit": 300
      }
    },
    "y": {
      "field": "price_rm",
      "type": "quantitative",
      "title": "Advertised price (RM, logarithmic scale)",
      "scale": {
        "type": "log"
      },
      "axis": {
        "values": [
          10,
          20,
          50,
          100,
          200,
          500,
          1000,
          2000,
          5000,
          10000
        ],
        "labelExpr": "'RM'+format(datum.value,'~g')"
      }
    },
    "detail": {
      "field": "product_id"
    },
    "color": {
      "field": "short_title",
      "type": "nominal",
      "scale": {
        "range": [
          "#17857c",
          "#8266b2",
          "#ce7b22",
          "#396ea2",
          "#b04d68"
        ]
      },
      "legend": {
        "title": "Selected food-storage listings",
        "titleLimit": 600,
        "orient": "top",
        "columns": 1,
        "labelLimit": 540,
        "labelFontSize": 11
      }
    },
    "tooltip": [
      {
        "field": "title",
        "title": "Listing"
      },
      {
        "field": "price_type",
        "title": "Price field"
      },
      {
        "field": "price_rm",
        "type": "quantitative",
        "title": "Price (RM)",
        "format": ".2f"
      },
      {
        "field": "price_ori",
        "type": "quantitative",
        "title": "Advertised reference (RM)",
        "format": ".2f"
      },
      {
        "field": "price_actual",
        "type": "quantitative",
        "title": "Listed selling price (RM)",
        "format": ".2f"
      },
      {
        "field": "total_rating",
        "title": "Rating count (source)"
      },
      {
        "field": "w_date",
        "title": "Observed on"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 85
      }
    }
  ]
}
