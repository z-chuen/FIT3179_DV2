{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Waffle chart of source rating-count bands. Abbreviated k/m source counts are interpreted at the displayed precision, not treated as exact integers. Exact sample proportions are shown next to the rounded 100-cell allocation. Largest-remainder allocation ensures exactly 100 squares.",
  "width": 900,
  "height": 620,
  "padding": {
    "left": 12,
    "right": 12,
    "top": 95,
    "bottom": 75
  },
  "autosize": {
    "type": "none",
    "contains": "padding",
    "resize": true
  },
  "background": "#ffffff",
  "title": {
    "text": [
      "How much feedback",
      "supports the ratings?"
    ],
    "subtitle": [
      "Shopee Malaysia | 24 Apr–13 May 2023",
      "100 squares represent the selected listings; allocation is rounded."
    ],
    "anchor": "start",
    "font": "Arial",
    "fontSize": 20,
    "color": "#172b46",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleColor": "#536174",
    "offset": 16
  },
  "signals": [
    {
      "name": "tile",
      "update": "min((width-16)/10, 28)"
    },
    {
      "name": "totalListings",
      "update": "data('bands').length ? data('bands')[0].total : 0"
    }
  ],
  "data": [
    {
      "name": "products",
      "url": "https://raw.githubusercontent.com/z-chuen/FIT3179_DV2/main/data/shopee_household_2023.csv",
      "format": {
        "type": "csv",
        "parse": {
          "rating_count": "number"
        }
      }
    },
    {
      "name": "bands",
      "source": "products",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.rating_count) && datum.rating_count >= 0"
        },
        {
          "type": "formula",
          "expr": "datum.rating_count < 100 ? 0 : datum.rating_count < 1000 ? 1 : 2",
          "as": "band_order"
        },
        {
          "type": "aggregate",
          "groupby": [
            "band_order"
          ],
          "ops": [
            "count"
          ],
          "as": [
            "n"
          ]
        },
        {
          "type": "joinaggregate",
          "ops": [
            "sum"
          ],
          "fields": [
            "n"
          ],
          "as": [
            "total"
          ]
        },
        {
          "type": "formula",
          "expr": "100*datum.n/datum.total",
          "as": "raw_cells"
        },
        {
          "type": "formula",
          "expr": "floor(datum.raw_cells)",
          "as": "base"
        },
        {
          "type": "formula",
          "expr": "datum.raw_cells-datum.base",
          "as": "fraction"
        },
        {
          "type": "joinaggregate",
          "ops": [
            "sum"
          ],
          "fields": [
            "base"
          ],
          "as": [
            "base_total"
          ]
        },
        {
          "type": "window",
          "sort": {
            "field": [
              "fraction",
              "band_order"
            ],
            "order": [
              "descending",
              "ascending"
            ]
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "remainder_rank"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.base + (datum.remainder_rank <= 100-datum.base_total ? 1 : 0)",
          "as": "cells"
        },
        {
          "type": "stack",
          "field": "cells",
          "sort": {
            "field": "band_order",
            "order": "ascending"
          },
          "as": [
            "start",
            "end"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.band_order===0 ? 'Under 100 ratings' : datum.band_order===1 ? '100–999 ratings' : '1,000+ ratings'",
          "as": "label"
        },
        {
          "type": "collect",
          "sort": {
            "field": "band_order",
            "order": "ascending"
          }
        }
      ]
    },
    {
      "name": "squares",
      "transform": [
        {
          "type": "sequence",
          "start": 0,
          "stop": 100,
          "step": 1,
          "as": "cell"
        },
        {
          "type": "formula",
          "expr": "datum.cell < data('bands')[0].end ? 0 : datum.cell < data('bands')[1].end ? 1 : 2",
          "as": "band_order"
        },
        {
          "type": "lookup",
          "from": "bands",
          "key": "band_order",
          "fields": [
            "band_order"
          ],
          "as": [
            "band"
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "bandColour",
      "type": "ordinal",
      "domain": [
        0,
        1,
        2
      ],
      "range": [
        "#e4a24b",
        "#8fa2bb",
        "#17857c"
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "squares"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.cell%10)*tile+8"
          },
          "y": {
            "signal": "floor(datum.cell/10)*tile+8"
          },
          "width": {
            "signal": "tile-2"
          },
          "height": {
            "signal": "tile-2"
          },
          "cornerRadius": {
            "value": 2
          },
          "fill": {
            "scale": "bandColour",
            "field": "band_order"
          },
          "tooltip": {
            "signal": "{'Rating-count band':datum.band.label,'Listings':datum.band.n,'Share of listings':format(datum.band.n/datum.band.total,'.1%'),'Rounded squares':datum.band.cells}"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "bands"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "width < 650 ? 8 : 340"
          },
          "y": {
            "signal": "(width < 650 ? 10*tile+32 : 55) + datum.band_order*42"
          },
          "width": {
            "value": 14
          },
          "height": {
            "value": 14
          },
          "fill": {
            "scale": "bandColour",
            "field": "band_order"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "bands"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "width < 650 ? 30 : 365"
          },
          "y": {
            "signal": "(width < 650 ? 10*tile+44 : 67) + datum.band_order*42"
          },
          "text": {
            "signal": "datum.label + ': ' + format(datum.n/datum.total,'.1%') + ' (' + datum.n + ' listings)'"
          },
          "font": {
            "value": "Arial"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#172b46"
          },
          "limit": {
            "signal": "width < 650 ? width-40 : width-380"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 8
          },
          "y": {
            "signal": "height-8"
          },
          "text": {
            "value": "Rating counts support interpretation; they are not verified sales totals."
          },
          "font": {
            "value": "Arial"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#536174"
          },
          "limit": {
            "signal": "width-16"
          }
        }
      }
    }
  ]
}
