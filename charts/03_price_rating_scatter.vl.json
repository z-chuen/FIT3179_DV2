{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Price-versus-rating scatter plot of positive-price household listings. Each point is one listing; no coordinate jitter is applied. A logarithmic price scale shows the wide range among retained sale listings. Association does not establish product quality or causation. Price comparisons exclude five source-reviewed gift/redemption/non-sale listings by product_id: 44437739.12410830021, 52784309.18045431232, 52784309.22224842773, 62781995.22828814214, 635979077.21639543747. This is a listing-type rule, not a price cutoff; genuine sale bundles mentioning free gifts remain included. The shared CSV is unchanged. The 343 retained positive prices range from RM0.06 to RM299.",
  "width": 760,
  "height": 400,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": false
  },
  "padding": {
    "top": 12,
    "left": 8,
    "right": 12,
    "bottom": 12
  },
  "title": {
    "text": "Shopee Malaysia | 2023",
    "subtitle": [
      "24 Apr–13 May | n = 343",
      "5 gift listings excluded"
    ],
    "anchor": "start",
    "fontSize": 12,
    "fontWeight": "normal",
    "subtitleFontSize": 11,
    "subtitlePadding": 4,
    "offset": 14
  },
  "config": {
    "font": "Arial",
    "background": "#ffffff",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#465467",
      "titleColor": "#172b46",
      "gridColor": "#e6ecf0",
      "domainColor": "#bdc8d2",
      "tickColor": "#bdc8d2",
      "titlePadding": 12,
      "labelPadding": 5
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#465467",
      "titleColor": "#172b46",
      "symbolStrokeWidth": 0
    },
    "title": {
      "fontSize": 12,
      "color": "#172b46",
      "subtitleFontSize": 11,
      "subtitleColor": "#536174",
      "anchor": "start",
      "offset": 16
    }
  },
  "data": {
    "url": "data/shopee_household_2023.csv",
    "format": {
      "type": "csv",
      "parse": {
        "price_actual": "number",
        "price_ori": "number",
        "item_rating": "number",
        "rating_count": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.item_rating) && datum.item_rating >= 1 && datum.item_rating <= 5"
    },
    {
      "filter": "isValid(datum.price_actual) && datum.price_actual > 0"
    },
    {
      "filter": "indexof([\"44437739.12410830021\",\"52784309.18045431232\",\"52784309.22224842773\",\"62781995.22828814214\",\"635979077.21639543747\"], datum.product_id) < 0"
    }
  ],
  "params": [
    {
      "name": "groupHighlight",
      "select": {
        "type": "point",
        "fields": [
          "topic_group"
        ],
        "toggle": "true"
      },
      "bind": "legend"
    }
  ],
  "mark": {
    "type": "point",
    "filled": true,
    "size": 46,
    "stroke": "#ffffff",
    "strokeWidth": 0.5
  },
  "encoding": {
    "x": {
      "field": "price_actual",
      "type": "quantitative",
      "title": "Price (RM, log scale)",
      "scale": {
        "type": "log",
        "domain": [
          0.05,
          400
        ],
        "nice": false
      },
      "axis": {
        "values": [
          0.1,
          1,
          10,
          100,
          300
        ],
        "labelExpr": "'RM' + format(datum.value, '~g')",
        "labelOverlap": "greedy",
        "labelSeparation": 8,
        "labelFlush": 20,
        "labelFontSize": 11,
        "titleFontSize": 12,
        "grid": true
      }
    },
    "y": {
      "field": "item_rating",
      "type": "quantitative",
      "title": "Rating out of 5",
      "scale": {
        "domain": [
          0,
          5
        ],
        "zero": true
      },
      "axis": {
        "values": [
          0,
          1,
          2,
          3,
          4,
          5
        ],
        "format": ".0f"
      }
    },
    "color": {
      "field": "topic_group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Cleaning supplies",
          "Storage products",
          "Kitchen essentials"
        ],
        "range": [
          "#17857c",
          "#8266b2",
          "#ce7b22"
        ]
      },
      "legend": {
        "title": "Product group",
        "orient": "top",
        "direction": "horizontal",
        "columns": {
          "expr": "width < 460 ? 1 : 3"
        },
        "labelLimit": 200,
        "rowPadding": 5,
        "columnPadding": 18,
        "offset": 12,
        "titleFontSize": 11,
        "labelFontSize": 11
      }
    },
    "opacity": {
      "condition": {
        "param": "groupHighlight",
        "value": 0.8
      },
      "value": 0.13
    },
    "tooltip": [
      {
        "field": "title",
        "type": "nominal",
        "title": "Listing"
      },
      {
        "field": "topic_group",
        "type": "nominal",
        "title": "Product group"
      },
      {
        "field": "source_category_group",
        "type": "nominal",
        "title": "Category group"
      },
      {
        "field": "product_category",
        "type": "nominal",
        "title": "Detailed category"
      },
      {
        "field": "price_actual",
        "type": "quantitative",
        "title": "Listed price (RM)",
        "format": ".2f"
      },
      {
        "field": "item_rating",
        "type": "quantitative",
        "title": "Rating out of 5",
        "format": ".1f"
      },
      {
        "field": "total_rating",
        "type": "nominal",
        "title": "Rating count (source)"
      },
      {
        "field": "w_date",
        "type": "nominal",
        "title": "Observed on"
      },
      {
        "field": "product_id",
        "type": "nominal",
        "title": "Listing ID"
      }
    ]
  }
}
